---
// src/components/Popup.astro
---

<button
  id="bell-btn"
  style="
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 9999;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3b82f6;
    color: white;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: grab;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    user-select: none;
  "
>
  🔔
</button>

<dialog
  id="welcome-dialog"
  style="
    position: fixed;
    top: 80px;
    right: 16px;
    margin: 0;
    width: 320px;
    padding: 24px;
    border: none;
    border-radius: 16px;
    background: white;
    color: #1e293b;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  "
>
  <h2 style="font-size:20px;font-weight:bold;margin-bottom:16px;">广告:RoseShop.Asia</h2>
  <p style="margin-bottom:20px;color:#475569;">我的世界Rose卡网—老牌卡网
各大客户端hyp/bjd等 黑卡
热注入 全脱以及其他游戏外挂等 官方代理 值得信赖</p>
  <form method="dialog">
    <button
      style="
        width: 100%;
        background: #3b82f6;
        color: white;
        border: none;
        padding: 10px 0;
        border-radius: 8px;
        font-size: 14px;
        cursor: pointer;
      "
    >
      OK
    </button>
  </form>
</dialog>

<style>
  :root.dark #welcome-dialog {
    background: #1e293b;
    color: #e2e8f0;
  }
  :root.dark #welcome-dialog p {
    color: #94a3b8;
  }
  #welcome-dialog::backdrop {
    background: rgba(0,0,0,0.5);
  }
</style>

<script>
  const dialog = document.getElementById('welcome-dialog');
  const bellBtn = document.getElementById('bell-btn');

  // 进站自动弹出
  window.addEventListener('load', () => {
    dialog.showModal();
  });

  // 点击铃铛重新打开弹窗（拖动时不会触发）
  bellBtn.addEventListener('click', (e) => {
    // 如果刚刚发生了拖动，阻止本次 click
    if (bellBtn.dataset.wasDragged === 'true') {
      e.preventDefault();
      e.stopPropagation();
      delete bellBtn.dataset.wasDragged;
      return;
    }
    dialog.showModal();
  });

  // ----- 拖动功能 -----
  let isDragging = false;
  let startX, startY, startLeft, startTop;

  // 恢复上次保存的位置
  function loadPosition() {
    const saved = localStorage.getItem('bell-btn-pos');
    if (saved) {
      const { left, top } = JSON.parse(saved);
      bellBtn.style.left = left + 'px';
      bellBtn.style.top = top + 'px';
      bellBtn.style.right = 'auto'; // 取消 right 的约束
    }
  }

  // 保存位置
  function savePosition() {
    const rect = bellBtn.getBoundingClientRect();
    const pos = {
      left: rect.left,
      top: rect.top,
    };
    localStorage.setItem('bell-btn-pos', JSON.stringify(pos));
  }

  // 开始拖动
  function onStart(e) {
    isDragging = true;
    bellBtn.style.cursor = 'grabbing';

    // 记录起始点
    const touch = e.touches ? e.touches[0] : e;
    startX = touch.clientX;
    startY = touch.clientY;

    const rect = bellBtn.getBoundingClientRect();
    startLeft = rect.left;
    startTop = rect.top;

    // 防止选中页面文字
    e.preventDefault();
  }

  // 拖动移动
  function onMove(e) {
    if (!isDragging) return;
    e.preventDefault();

    const touch = e.touches ? e.touches[0] : e;
    const dx = touch.clientX - startX;
    const dy = touch.clientY - startY;

    let newLeft = startLeft + dx;
    let newTop = startTop + dy;

    // 限制不超出屏幕边界
    const btnSize = 40;
    const maxLeft = window.innerWidth - btnSize;
    const maxTop = window.innerHeight - btnSize;

    newLeft = Math.max(0, Math.min(newLeft, maxLeft));
    newTop = Math.max(0, Math.min(newTop, maxTop));

    bellBtn.style.left = newLeft + 'px';
    bellBtn.style.top = newTop + 'px';
    bellBtn.style.right = 'auto'; // 取消 right 固定
  }

  // 结束拖动
  function onEnd() {
    if (!isDragging) return;
    isDragging = false;
    bellBtn.style.cursor = 'grab';
    savePosition();

    // 标记发生了拖动，防止触发 click
    bellBtn.dataset.wasDragged = 'true';
    setTimeout(() => {
      delete bellBtn.dataset.wasDragged;
    }, 200);
  }

  // 绑定事件
  bellBtn.addEventListener('mousedown', onStart);
  bellBtn.addEventListener('touchstart', onStart, { passive: false });

  window.addEventListener('mousemove', onMove);
  window.addEventListener('touchmove', onMove, { passive: false });

  window.addEventListener('mouseup', onEnd);
  window.addEventListener('touchend', onEnd);

  // 初始化位置
  loadPosition();
</script>