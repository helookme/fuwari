---
// src/pages/links.astro
import Layout from "../layouts/Layout.astro";
import { friends } from "../data/friends";
---

<Layout title="友情链接" description="加友链联系TG">
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: 2rem; font-weight: 600; margin-bottom: 2rem; text-align: center;">友情链接</h1>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {friends.map((link) => (
        <a 
          href={link.url} 
          target="_blank" 
          rel="noopener noreferrer"
          style="
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1.5rem 1rem;
            background: var(--color-card-bg, #ffffff);
            border: 1px solid var(--color-border, #eaeef2);
            border-radius: 1rem;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
          "
          onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 24px -8px rgba(0,0,0,0.15)'"
          onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 8px rgba(0,0,0,0.02)'"
        >
          <img 
            src={link.avatar} 
            alt={link.name}
            style="
              width: 80px;
              height: 80px;
              border-radius: 50%;
              object-fit: cover;
              margin-bottom: 1rem;
              border: 2px solid var(--color-primary, #6366f1);
            "
          />
          <h3 style="font-size: 1.25rem; font-weight: 600; margin: 0 0 0.5rem 0; color: var(--color-text, #1e293b);">
            {link.name}
          </h3>
          <p style="font-size: 0.9rem; color: var(--color-text-light, #64748b); margin: 0 0 0.75rem 0; text-align: center; line-height: 1.5;">
            {link.description}
          </p>
          <span style="font-size: 0.8rem; color: var(--color-primary, #6366f1); border: 1px solid currentColor; padding: 0.25rem 0.75rem; border-radius: 999px;">
            访问网站 →
          </span>
        </a>
      ))}
    </div>
  </div>
</Layout>