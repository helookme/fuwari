---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

// 获取 Cloudflare Pages 环境变量（本地开发时显示 dev/local）
const commitSha = import.meta.env.CF_PAGES_COMMIT_SHA
  ? import.meta.env.CF_PAGES_COMMIT_SHA.slice(0, 8)
  : 'dev';
const commitTimestamp = import.meta.env.CF_PAGES_COMMIT_TIMESTAMP
  ? new Date(import.meta.env.CF_PAGES_COMMIT_TIMESTAMP).toLocaleString()
  : 'local';
---


<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>

<div class="transition overlay-panel rounded-2xl mb-12 flex flex-col items-center justify-center px-6 py-6">
    <div class="transition text-50 text-sm text-center">
        &copy; <span>{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
        <br>
        <a href="https://icp.gov.moe/?keyword=20260130" target="_blank">萌ICP备20260130号</a>
    </div>

    <!-- 版本和节点信息合并为一行 -->
    <div class="text-50 text-xs text-center text-gray-500 dark:text-gray-400 mt-2">
        ({commitSha} @ {commitTimestamp})
        {import.meta.env.PUBLIC_HOSTING_PLATFORM ? ` | 响应节点：${import.meta.env.PUBLIC_HOSTING_PLATFORM}` : ' | 响应节点：未知平台'}
    </div>
</div>