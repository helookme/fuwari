---
// 导入播放器组件和歌单数据
import APlayer from './APlayer.svelte';
import musics from '/public/lib/MasterMusic.js';

// 判断歌单是单首还是多首，转换成播放器需要的格式
const audioData = Array.isArray(musics) 
  ? musics.map(m => ({
      name: m.name,
      artist: m.artist,
      url: m.url,
      cover: m.cover,
      // 如果有歌词也可以加上 lrc: m.lrc
    }))
  : [{
      name: musics.name,
      artist: musics.artist,
      url: musics.url,
      cover: musics.cover,
    }];
---

<!-- 使用 client:idle 让播放器在空闲时加载 -->
<APlayer 
  client:idle
  audio={audioData}
  theme="#b7daff"
  autoplay={false}
  loop="all"
  order="list"
  volume={0.7}
  mini={false}
/>