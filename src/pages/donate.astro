---
// 导入Fuwari主题的默认布局（请根据实际路径调整）
import Layout from '../layouts/Layout.astro';

const title = '支持我 · 捐赠';
const description = '如果您喜欢我的内容，欢迎通过微信或支付宝支持我，非常感谢！';
---

<Layout title={title} description={description}>
  <main class="donate-container">
    <header class="donate-header">
      <h1>☕ 请我喝杯咖啡</h1>
      <p class="donate-description">
        您的支持是我持续创作的动力。<br />
        扫描下方二维码，无论多少都是心意。
      </p>
    </header>

    <div class="donate-methods">
      <!-- 微信支付 -->
      <div class="donate-card">
        <h2>微信支付</h2>
        <div class="qr-wrapper">
          <!-- 请将微信收款二维码图片放到 public/images/wechat-qr.jpg -->
          <img src="/images/wechat-qr.png" alt="微信支付二维码" width="200" height="200" loading="lazy" />
        </div>
        <p class="note">长按识别或扫一扫</p>
      </div>

      <!-- 支付宝 -->
      <div class="donate-card">
        <h2>支付宝</h2>
        <div class="qr-wrapper">
          <!-- 请将支付宝收款二维码图片放到 public/images/alipay-qr.jpg -->
          <img src="/images/alipay-qr.jpg" alt="支付宝二维码" width="200" height="200" loading="lazy" />
        </div>
        <p class="note">扫一扫向我付款</p>
      </div>
    </div>

    <!-- 致谢区 -->
    <section class="thankyou">
      <h2>❤️ 感谢每一份支持</h2>
      <p>你的鼓励让我走得更远。</p>
    </section>
  </main>
</Layout>

<style is:global>
  .donate-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .donate-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .donate-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #f6ad55, #ed8936);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .donate-description {
    font-size: 1.2rem;
    color: var(--color-text-light, #4a5568);
    line-height: 1.6;
  }

  .donate-methods {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .donate-card {
    flex: 0 1 320px;
    max-width: 320px;
    background: var(--color-bg-card, #ffffff);
    border-radius: 1rem;
    padding: 1.8rem 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    text-align: center;
    transition: transform 0.2s ease;
    border: 1px solid var(--color-border, #e2e8f0);
  }

  .donate-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.15);
  }

  .donate-card h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-heading, #2d3748);
    border-bottom: 2px dashed var(--color-accent, #ed8936);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .qr-wrapper {
    background: #f7fafc;
    padding: 1rem;
    border-radius: 0.75rem;
    margin-bottom: 1rem;
    display: inline-block;
    border: 1px solid var(--color-border-light, #edf2f7);
  }

  .qr-wrapper img {
    display: block;
    border-radius: 0.5rem;
    width: 200px;
    height: 200px;
    object-fit: cover;
  }

  .note {
    font-size: 0.95rem;
    color: var(--color-text-light, #718096);
    margin-top: 0.5rem;
  }

  .thankyou {
    text-align: center;
    margin-top: 3rem;
    padding: 2rem;
    background: var(--color-bg-soft, #fefcbf);
    border-radius: 1rem;
    border-left: 4px solid var(--color-accent, #ed8936);
  }

  .thankyou h2 {
    font-size: 1.8rem;
    color: var(--color-heading, #2d3748);
    margin-bottom: 1rem;
  }

  .thankyou p {
    color: var(--color-text, #2d3748);
    font-size: 1.1rem;
  }

  /* 暗色模式适配 */
  :root.dark .donate-card {
    background: #2d3748;
    border-color: #4a5568;
  }

  :root.dark .qr-wrapper {
    background: #1a202c;
  }

  :root.dark .thankyou {
    background: #2d3748;
    border-left-color: #ed8936;
  }
</style>