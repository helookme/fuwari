---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";
import { umamiConfig } from "../config";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

// 封面宽度：桌面端 28%，移动端 33.333%（w-1/3）
const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();
---

<!-- 卡片容器：固定高度 + 横向布局 + 加大圆角 + 毛玻璃 -->
<div
	class:list={[
		"post-card",
		"flex flex-row",                        // 强制横向排列
		"h-52 md:h-60",                         // 固定高度（移动端 13rem，桌面端 15rem）
		"w-full",
		"rounded-2xl",                          // 更大圆角
		"overflow-hidden",
		"relative",
		"transition-all duration-300",
		"border border-white/30 dark:border-white/10",
		"shadow-lg hover:shadow-xl",
		className
	]}
	style={style}
>
	{/* 信息区域：自动填充剩余宽度 */}
	<div class="flex-1 flex flex-col justify-center px-5 md:px-6 py-4">
		<a
			href={url}
			class="group block font-bold text-xl md:text-2xl text-90 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] transition-colors mb-2 line-clamp-2"
		>
			{title}
		</a>

		<PostMetadata
			published={published}
			updated={updated}
			tags={tags}
			category={category}
			hideTagsForMobile={true}
			hideUpdateDate={true}
			class="mb-2 text-sm"
		/>

		<p class="text-sm text-75 line-clamp-2 md:line-clamp-3 mb-2 pr-2">
			{description || remarkPluginFrontmatter.excerpt}
		</p>

		<div class="text-xs text-black/40 dark:text-white/40 flex items-center gap-3 mt-auto">
			<span>{remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</span>
			<span class="w-0.5 h-0.5 rounded-full bg-current opacity-40"></span>
			<span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
			<span class="text-50" id={`page-views-${entry.slug}`}>加载中...</span>
		</div>
	</div>

	{/* 封面区域：固定宽度，图片自适应填满 */}
	{hasCover ? (
		<a
			href={url}
			aria-label={title}
			class="block w-1/3 md:w-[var(--coverWidth)] h-full flex-shrink-0 relative group overflow-hidden rounded-r-2xl"
		>
			<div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 group-active:bg-black/40 transition-colors z-10 rounded-r-2xl"></div>
			<div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none">
				<Icon
					name="material-symbols:chevron-right-rounded"
					class="text-white text-4xl opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 transition-all"
				/>
			</div>
			<ImageWrapper
				src={image}
				basePath={path.join("content/posts/", getDir(entry.id))}
				alt={`Cover of ${title}`}
				class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
			/>
		</a>
	) : (
		<a
			href={url}
			aria-label={title}
			class="hidden md:flex items-center justify-center w-12 h-full flex-shrink-0 bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] transition-colors rounded-r-2xl"
		>
			<Icon name="material-symbols:chevron-right-rounded" class="text-[var(--primary)] text-3xl" />
		</a>
	)}
</div>

<!-- 移动端分隔线（可保留，但已用卡片间距控制，可自行决定是否隐藏） -->
<div class="md:hidden border-t border-dashed border-black/10 dark:border-white/15 mx-4 last:hidden"></div>

<script define:vars={{ entry, umamiConfig, coverWidth }}>
	// ... 保持原有浏览量获取逻辑不变 ...
	async function fetchPostCardViews(slug) {
		if (!umamiConfig.enable) return;
		try {
			const shareResponse = await fetch(`${umamiConfig.baseUrl}/api/share/${umamiConfig.shareId}`);
			if (!shareResponse.ok) throw new Error("获取分享信息失败");
			const shareData = await shareResponse.json();
			const { websiteId, token } = shareData;
			const currentTimestamp = Date.now();
			const postPath = `/posts/${slug}/`;
			const statsUrl = `${umamiConfig.baseUrl}/api/websites/${websiteId}/stats?startAt=0&endAt=${currentTimestamp}&unit=hour&timezone=${encodeURIComponent(umamiConfig.timezone)}&path=${encodeURIComponent(postPath)}&compare=false`;
			const statsResponse = await fetch(statsUrl, {
				headers: { "x-umami-share-token": token },
			});
			if (!statsResponse.ok) throw new Error("获取统计数据失败");
			const statsData = await statsResponse.json();
			const pageViews = Number(statsData.pageviews ?? 0);
			const displayElement = document.getElementById(`page-views-${entry.slug}`);
			if (displayElement) displayElement.textContent = ` · ${pageViews} 阅读`;
		} catch (error) {
			console.error(error);
			const displayElement = document.getElementById(`page-views-${entry.slug}`);
			if (displayElement) displayElement.textContent = " · 统计不可用";
		}
	}
	function initPostCardStats() {
		if (entry.slug) fetchPostCardViews(entry.slug);
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPostCardStats);
	} else {
		initPostCardStats();
	}
</script>

<style define:vars={{ coverWidth }}>
	/* 卡片容器毛玻璃效果（直接写在此处，确保覆盖） */
	.post-card {
		background-color: rgba(255, 255, 255, 0.2) !important;
		-webkit-backdrop-filter: blur(25px) saturate(200%) !important;
		backdrop-filter: blur(25px) saturate(200%) !important;
	}

	.dark .post-card {
		background-color: rgba(20, 20, 30, 0.3) !important;
	}

	/* 悬浮时背景稍微变亮 */
	.post-card:hover {
		background-color: rgba(255, 255, 255, 0.3) !important;
	}

	.dark .post-card:hover {
		background-color: rgba(35, 35, 50, 0.4) !important;
	}

	/* 封面图片圆角适配 */
	.post-card a[href*="/posts/"] img {
		border-radius: 0 1rem 1rem 0;
	}
</style>